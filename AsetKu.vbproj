<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AsetKu</RootNamespace>
    <AssemblyName>AsetKu</AssemblyName>
    <StartupObject>Sub Main</StartupObject>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="FormLogin.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormLogin.Designer.vb">
      <DependentUpon>FormLogin.vb</DependentUpon>
    </Compile>
    <Compile Update="FormMain.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="FormMain.Designer.vb">
      <DependentUpon>FormMain.vb</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
